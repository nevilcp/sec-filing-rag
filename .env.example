# Enter your Groq API key for LLM routing and grading
GROQ_API_KEY=

# Enter your Gemini API key for final response generation
GEMINI_API_KEY=

# Enter a valid contact email to comply with SEC EDGAR rate-limit policies
EDGAR_CONTACT_EMAIL=contact@example.com

# Set to 'true' to enable Arize Phoenix OpenTelemetry tracing, or leave blank to disable
PHOENIX_ENABLED=

# Enter one or more comma-separated fiscal years to filter filings during ingestion
EDGAR_FISCAL_YEAR=2024,2025
