# Guardrails, routing, grading, and rewriting.
GROQ_API_KEY=

# Final answer generation.
GEMINI_API_KEY=

# Included in the SEC User-Agent header.
EDGAR_CONTACT_EMAIL=contact@example.com

# Comma-separated report years.
EDGAR_FISCAL_YEAR=2024,2025

# Optional overrides; leave commented to use defaults.

# API_HOST=0.0.0.0
# API_PORT=8000

# Development only.
# UVICORN_RELOAD=false

# PHOENIX_HOST=localhost
# PHOENIX_PORT=6006
# Enable tracing when Phoenix is running.
# PHOENIX_ENABLED=false

# GRADIO_HOST=0.0.0.0
# GRADIO_PORT=7860
# API_BASE_URL=http://localhost:8000

# Comma-separated origins; unset uses local development origins.
# CORS_ORIGINS=

# Keep concurrency low for the shared Groq model budget.
# EVAL_CONCURRENCY=2

# Match the output classifier's per-minute token allowance to your Groq account.
# OUTPUT_GUARD_TPM=2000
# Allow time for local model loading and provider rate-limit pacing.
# QUERY_TIMEOUT_SECONDS=300
