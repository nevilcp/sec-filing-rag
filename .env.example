# Enter your Groq API key for the guardrail, routing, grading and rewriting models
GROQ_API_KEY=

# Enter your Gemini API key for final response generation
GEMINI_API_KEY=

# Enter a valid contact email to comply with SEC EDGAR rate-limit policies
EDGAR_CONTACT_EMAIL=contact@example.com

# Set to 'true' to enable Arize Phoenix OpenTelemetry tracing, or leave blank to disable
PHOENIX_ENABLED=

# Enter one or more comma-separated fiscal years to filter 10-K filings during ingestion
EDGAR_FISCAL_YEAR=2024,2025

# Optional settings. Each line shows the default, which is used when the variable is unset.

# Address and port the API server binds to
# API_HOST=0.0.0.0
# API_PORT=8000

# Restart the API server on code changes (development only)
# UVICORN_RELOAD=false

# Where the Arize Phoenix server runs
# PHOENIX_HOST=localhost
# PHOENIX_PORT=6006

# Address and port of the Gradio UI, and where it reaches the API
# GRADIO_HOST=0.0.0.0
# GRADIO_PORT=7860
# API_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API (defaults to local development origins)
# CORS_ORIGINS=

# Concurrent judge calls in the Phoenix evaluations (kept low for Groq free-tier limits)
# EVAL_CONCURRENCY=2
